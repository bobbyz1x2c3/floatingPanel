{
  "name": "nemu-float",
  "version": "0.3.0",
  "private": true,
  "description": "Neumorphic floating card board for desktop, web and mobile",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 4173 --configLoader runner",
    "icon": "tauri icon src-tauri/icon-source.png",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "npm run cli:stage && tauri build",
    "cli:build": "cargo build --release --manifest-path src-tauri/Cargo.toml -p nemufloat-cli",
    "cli:stage": "npm run cli:build && node scripts/stage-cli.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "mqtt": "^5.16.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
